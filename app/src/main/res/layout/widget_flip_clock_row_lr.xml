<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <!-- 左邊：與右卡完全等高嘅機械翻頁鐘 -->
        <LinearLayout
            android:id="@+id/widget_clock_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/widget_hour_card_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_flip_card" />

                <TextClock
                    android:id="@+id/widget_hour"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:format12Hour="hh"
                    android:format24Hour="HH"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#FFF4F4F5"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="#80000000"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_colon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:text=":"
                android:textColor="#FF71717A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/widget_min_card_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_flip_card" />

                <TextClock
                    android:id="@+id/widget_minute"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:format12Hour="mm"
                    android:format24Hour="mm"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#FFF4F4F5"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="#80000000"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>

        <!-- 右邊：與時鐘完全等高嘅天氣卡片 -->
        <FrameLayout
            android:id="@+id/widget_weather_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_weather_card_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_flip_card" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp">

                <!-- 頂部：日期 · 地區 + 更新時間 + 內置設定齒輪 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextClock
                        android:id="@+id/widget_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="M月d日 EEE · "
                        android:format24Hour="M月d日 EEE · "
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#FFA1A1AA"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_city"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Hong Kong"
                        android:textColor="#FFA1A1AA"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_updated_at"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:includeFontPadding="false"
                        android:text=""
                        android:textColor="#77A1A1AA"
                        android:textSize="8.5sp" />

                    <TextView
                        android:id="@+id/widget_config_btn"
                        android:layout_width="20dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="⚙"
                        android:textColor="#99A1A1AA"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 中部：天氣圖示 + 放大實時氣溫 + 狀況 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_weather_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="☁️"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/widget_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:includeFontPadding="false"
                        android:text="--°C"
                        android:textColor="#FF38BDF8"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_condition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="輕觸更新"
                        android:textColor="#FFE4E4E7"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- 底部：未來每 4 小時三欄對齊預報格 -->
                <LinearLayout
                    android:id="@+id/widget_forecast_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_fc_1_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="--:--"
                            android:textColor="#FFA1A1AA"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/widget_fc_1_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:includeFontPadding="false"
                            android:text="--°"
                            android:textColor="#FFF4F4F5"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_fc_2_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="--:--"
                            android:textColor="#FFA1A1AA"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/widget_fc_2_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:includeFontPadding="false"
                            android:text="--°"
                            android:textColor="#FFF4F4F5"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_fc_3_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="--:--"
                            android:textColor="#FFA1A1AA"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/widget_fc_3_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:includeFontPadding="false"
                            android:text="--°"
                            android:textColor="#FFF4F4F5"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_forecast_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
