<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <!-- 右上角手動設定按鈕 -->
    <TextView
        android:id="@+id/widget_config_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:gravity="center"
        android:text="⚙"
        android:textColor="#88A1A1AA"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="22dp"
        android:paddingBottom="6dp">

        <!-- 左邊：橫排翻頁鐘（時 : 分） -->
        <LinearLayout
            android:id="@+id/widget_clock_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageView
                    android:id="@+id/widget_hour_card_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_flip_card" />

                <TextClock
                    android:id="@+id/widget_hour"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:format12Hour="hh"
                    android:format24Hour="HH"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#FFF4F4F5"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="#80000000"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_colon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text=":"
                android:textColor="#FF71717A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageView
                    android:id="@+id/widget_min_card_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_flip_card" />

                <TextClock
                    android:id="@+id/widget_minute"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:format12Hour="mm"
                    android:format24Hour="mm"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#FFF4F4F5"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="#80000000"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>

        <!-- 右邊：日期 + 實時天氣 + 每 4 小時預報 -->
        <FrameLayout
            android:id="@+id/widget_weather_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_weather_card_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_flip_card" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="9dp"
                android:paddingTop="5dp"
                android:paddingEnd="9dp"
                android:paddingBottom="5dp">

                <TextClock
                    android:id="@+id/widget_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:format12Hour="M月d日 · EEEE"
                    android:format24Hour="M月d日 · EEEE"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFA1A1AA"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_city"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Hong Kong"
                        android:textColor="#FFA1A1AA"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:includeFontPadding="false"
                        android:text="--°C"
                        android:textColor="#FF38BDF8"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_condition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="#FFE4E4E7"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_forecast_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#FFA1A1AA"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
