<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <TextClock
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:format12Hour="M月d日 · EEEE"
            android:format24Hour="M月d日 · EEEE"
            android:textColor="#FFA1A1AA"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_clock_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="86dp"
                android:layout_height="84dp">

                <ImageView
                    android:id="@+id/widget_hour_card_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_flip_card" />

                <TextClock
                    android:id="@+id/widget_hour"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:format12Hour="hh"
                    android:format24Hour="HH"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#FFF4F4F5"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="#80000000"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_colon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text=":"
                android:textColor="#FF71717A"
                android:textSize="32sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="86dp"
                android:layout_height="84dp">

                <ImageView
                    android:id="@+id/widget_min_card_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_flip_card" />

                <TextClock
                    android:id="@+id/widget_minute"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:format12Hour="mm"
                    android:format24Hour="mm"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#FFF4F4F5"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="#80000000"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_weather_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/widget_weather_card_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_flip_card" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_weather_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☁️"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/widget_city"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Hong Kong"
                        android:textColor="#FFA1A1AA"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="--°C"
                        android:textColor="#FF38BDF8"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_condition"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="輕觸更新"
                        android:textColor="#FFE4E4E7"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/widget_updated_at"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#77A1A1AA"
                        android:textSize="9.5sp" />

                    <TextView
                        android:id="@+id/widget_config_btn"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:gravity="center"
                        android:text="⚙"
                        android:textColor="#99A1A1AA"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_forecast_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_fc_1_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--:--"
                            android:textColor="#FFA1A1AA"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/widget_fc_1_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="--°"
                            android:textColor="#FFF4F4F5"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_fc_2_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--:--"
                            android:textColor="#FFA1A1AA"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/widget_fc_2_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="--°"
                            android:textColor="#FFF4F4F5"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_fc_3_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--:--"
                            android:textColor="#FFA1A1AA"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/widget_fc_3_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="--°"
                            android:textColor="#FFF4F4F5"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_forecast_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
